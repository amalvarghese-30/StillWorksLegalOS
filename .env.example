# =============================================================================
# StillWorks LegalOS — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env or any file containing real secrets to version control.
# =============================================================================

# ── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
SERVER_PORT=3001
SERVER_HOST=0.0.0.0

# ── Frontend API & Socket Routing ──────────────────────────────────────────
# In local development:
VITE_API_URL=http://localhost:3001/api
VITE_SOCKET_URL=http://localhost:3001
VITE_API_PROXY_TARGET=http://localhost:3001
# In future production:
# VITE_API_URL=https://<your-production-domain>/api
# VITE_SOCKET_URL=https://<your-production-domain>

# ── Database ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/stillworks_dev
MONGODB_DB_NAME=stillworks_legalos

# ── JWT (generate with: openssl rand -base64 64) ───────────────────────────
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── CORS Origins (comma-separated) ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,app://.

# ── Storage (VPS / local disk) ─────────────────────────────────────────────
STORAGE_DIR=./uploads

# ── Email (optional: password reset delivery) ──────────────────────────────
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# ── SMS (optional: OTP delivery) ───────────────────────────────────────────
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
