# =============================================================================
# StillWorks LegalOS — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env or any file containing real secrets to version control.
#
# Production secrets should come from:
#   - VPS/server environment variables (e.g., systemd EnvironmentFile)
#   - Docker secrets
#   - Hosting provider secret management (Railway, Render, etc.)
#   - A dedicated secret manager (Vault, AWS Secrets Manager, etc.)
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=production
SERVER_PORT=3001
SERVER_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=stillworks_legalos

# ---------------------------------------------------------------------------
# JWT (generate with: openssl rand -base64 64)
# Production: minimum 64 characters, must NOT be the default value
# ---------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_SECURE_RANDOM_64_CHAR_STRING
REFRESH_TOKEN_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins
# In production: use exact HTTPS origins only. Wildcards are rejected.
# ---------------------------------------------------------------------------
CORS_ORIGINS=https://legalos.stillworks.in,app://.

# ---------------------------------------------------------------------------
# Storage (NAS / local disk)
# ---------------------------------------------------------------------------
STORAGE_ROOT=/var/data/stillworks/documents

# ---------------------------------------------------------------------------
# Email (for password reset delivery)
# ---------------------------------------------------------------------------
# Supported providers: smtp, sendgrid, ses
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
EMAIL_FROM=noreply@legalos.stillworks.in

# ---------------------------------------------------------------------------
# SMS (for OTP delivery via phone)
# ---------------------------------------------------------------------------
# Optional — leave blank to disable SMS delivery
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Trust Proxy
# Set to "1" if running behind a reverse proxy (nginx, Caddy, etc.)
# that correctly sets X-Forwarded-For.
# ---------------------------------------------------------------------------
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
