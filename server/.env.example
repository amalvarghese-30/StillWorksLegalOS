# ── Server ──────────────────────────────────────────
NODE_ENV=development
SERVER_PORT=3001
SERVER_HOST=0.0.0.0

# ── MongoDB ─────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/stillworks

# ── JWT ─────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── CORS Origins (comma-separated) ──────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,app://.

# ── Storage (VPS / local disk filesystem storage) ────
STORAGE_DIR=./uploads

# ── At-rest encryption key for DB secrets ───────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=
