# ── Server ──────────────────────────────────────────
NODE_ENV=development
SERVER_PORT=3001

# ── MongoDB ─────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/stillworks

# ── JWT ─────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=15m

# ── CORS Origins (comma-separated) ──────────────────
# In production, this should include the Electron custom protocol
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,app://.

# ── Synology NAS (WebDAV — dynamic, also stored in DB) ──────
# Defaults; users configure via admin settings UI.
# Production: WebDAV over HTTPS through the Cloudflare Tunnel subdomain
# (files stay on the office Synology NAS — no cloud object storage).
NAS_URL=https://nas.stillworks.legal
NAS_USERNAME=
NAS_ROOT_PATH=/LegalOS

# ── At-rest encryption key for DB secrets (e.g. NAS password) ──────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=
