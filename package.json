{
  "name": "stillworks-legalos",
  "version": "1.0.0",
  "description": "StillWorks LegalOS - Premium Legal Practice Management Desktop Application",
  "author": "StillWorks",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite dev",
    "dev:electron": "concurrently -k \"vite dev\" \"npm run electron:wait\"",
    "dev:server": "cd server && npm run dev",
    "dev:all": "concurrently -k -n vite,electron,server -c cyan,green,yellow \"vite dev\" \"npm run electron:wait\" \"cd server && npm run dev\"",
    "electron:wait": "npm run electron:build && electron .",
    "electron:build": "tsc -p electron/tsconfig.json && node -e \"const fs=require('fs'); if(fs.existsSync('electron/preload.cjs')) fs.copyFileSync('electron/preload.cjs','dist-electron/preload.cjs');\"",
    "electron:start": "electron .",
    "build": "vite build",
    "build:client": "vite build && npm run electron:build",
    "build:all": "vite build && npm run electron:build && cd server && npm run build",
    "preview": "vite preview",
    "dist": "npm run build:client && electron-builder --config electron-builder.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "postinstall": "cd server && npm install"
  },
  "dependencies": {},
  "devDependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/router-plugin": "^1.168.23",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2",
    "@eslint/js": "^9.32.0",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.2",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.1.5"
  }
}
