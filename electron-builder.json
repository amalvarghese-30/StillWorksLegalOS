{
  "appId": "legal.stillworks.os",
  "productName": "S & S Legal-Tech LLP",
  "directories": {
    "buildResources": "public",
    "output": "release"
  },
  "publish": {
    "provider": "github",
    "owner": "amalvarghese-30",
    "repo": "StillWorksLegalOS",
    "releaseType": "release"
  },
  "asar": true,
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "win": {
    "target": "nsis",
    "icon": "public/icon.png",
    "executableName": "S & S Legal-Tech LLP"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "S & S Legal-Tech LLP",
    "artifactName": "${name}-setup-${version}.${ext}"
  }
}