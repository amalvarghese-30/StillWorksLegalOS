{
  "appId": "legal.stillworks.os",
  "productName": "StillWorks LegalOS",
  "directories": {
    "buildResources": "public",
    "output": "release"
  },
  "asar": true,
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "win": {
    "target": "nsis",
    "icon": "build/icon.png",
    "executableName": "StillWorks LegalOS"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "StillWorks LegalOS"
  }
}